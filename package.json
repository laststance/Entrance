{
  "name": "entrance",
  "productName": "Entrance",
  "version": "0.1.0",
  "description": "Record & replay debugger for local dev servers — replay a session like a video while a source-map-powered debugger highlights the executing code.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Laststance.io",
  "license": "MIT",
  "scripts": {
    "build:agent": "node scripts/build-agent.mjs",
    "dev": "node scripts/build-agent.mjs && electron-vite dev --watch",
    "dev:bg": "ENTRANCE_QA_BACKGROUND=1 pnpm dev",
    "build": "node scripts/build-agent.mjs && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/build-agent.mjs && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-jp": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@reduxjs/toolkit": "^2.12.0",
    "@rrweb/record": "2.1.0",
    "@rrweb/replay": "2.1.0",
    "@rrweb/types": "2.1.0",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.12.2",
    "react-virtuoso": "^4.18.10",
    "reselect": "^5.1.1",
    "tailwind-merge": "^3.6.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
